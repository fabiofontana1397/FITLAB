# Copy to .env (gitignored) and fill in the values printed by
# `npm run supabase:start`.
#
# The Supabase pair is read at BUILD time as well as at runtime: the static
# web export pre-renders every route in Node, which loads
# src/lib/supabase/client.ts, so `npx expo export --platform web` fails
# outright when either value is missing.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_VAPID_PUBLIC_KEY=

# Optional. Turns on the features that spend Claude credits (chat, Home
# insights, photo analysis); anything other than `true` keeps the local
# coach. See src/lib/assistant/ai-config.ts.
EXPO_PUBLIC_AI_COACH=false
