# Copy to .env (gitignored) and fill in the values printed by
# `npm run supabase:start`.
#
# The Supabase pair is read at BUILD time as well as at runtime: the static
# web export pre-renders every route in Node, which loads
# src/lib/supabase/client.ts, so `npx expo export --platform web` fails
# outright when either value is missing.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_VAPID_PUBLIC_KEY=

# Optional. Turns on the features that spend Claude credits (chat, Home
# insights, photo analysis); anything other than `true` keeps the local
# coach. See src/lib/assistant/ai-config.ts.
EXPO_PUBLIC_AI_COACH=false

# Packaged products (search + barcode) come from Open Food Facts through the
# food-search Edge Function. No API key; they only ask for a User-Agent that
# identifies the app with a contact, set as a function secret (not here):
#   supabase secrets set OFF_USER_AGENT="FitLab/1.0 (you@example.com)"
# For local `npm run functions:serve`, put it in supabase/.env.local.

# Sign in with Google (docs/SOCIAL-LOGIN.md). Without them the Google button is hidden.
# Web client id: the same one set in Supabase → Auth → Providers → Google.
# Default in src/lib/auth/social.ts (project fitlab-515611); set only to override.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS client id (bundle id com.fitlab.app): also becomes the URL scheme in app.config.js.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Web build only: `true` once Apple and Google are enabled in Supabase Auth (OAuth redirect).
EXPO_PUBLIC_SOCIAL_LOGIN_WEB=false
